	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="imagen" class="java.lang.String"/>
	<parameter name="P_FECHAINICIO" class="java.util.Date"/>
	<parameter name="P_FECHAFIN" class="java.util.Date"/>
	<parameter name="P_USUARIO" class="java.lang.Integer"/>
	<parameter name="P_NB_PANTA" class="java.lang.String"/>
	<parameter name="P_TP_PANTA" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	b.tp_panta,
    b.nb_panta,
    b.cd_docum,
    CONCAT(
    u.nombre, ' ',
  	u.apellido_1, ' ',
    u.apellido_2) AS nombre_completo,
   	b.fh_momento,
    b.hr_momento,
    b.nb_bitac
		FROM bitacora b
		INNER JOIN usuario u ON b.cd_usuario = u.id
		WHERE ($P{P_FECHAINICIO} IS NULL OR b.fh_momento >= $P{P_FECHAINICIO})
		AND ($P{P_FECHAFIN} IS NULL OR b.fh_momento <= $P{P_FECHAFIN})
  		AND ($P{P_USUARIO} IS NULL OR b.cd_usuario = $P{P_USUARIO})
  		AND ($P{P_NB_PANTA} IS NULL OR b.nb_panta = $P{P_NB_PANTA})
  		AND ($P{P_TP_PANTA} IS NULL OR b.tp_panta = $P{P_TP_PANTA})
  		ORDER BY u.nombre, u.apellido_1, u.apellido_2,
   		b.cd_docum,
   		b.fh_momento,
  		b.hr_momento;]]>
	</queryString>
