	<parameter name="imagen" class="java.lang.String"/>
	<parameter name="P_FECHAINICIO" class="java.util.Date"/>
	<parameter name="P_FECHAFIN" class="java.util.Date"/>
	<parameter name="P_CD_USUARIO" class="java.lang.Integer"/>
	<parameter name="P_NB_USUARIO" class="java.lang.String"/>
	<parameter name="P_NB_PANTA" class="java.lang.String"/>
	<parameter name="P_TP_PANTA" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	b.tp_panta,
    b.nb_panta,
    b.cd_docum,
    b.nb_usuario, 
   	b.fh_momento,
    b.hr_momento,
    b.nb_bitac
		FROM bitacora b
		WHERE ($P{P_FECHAINICIO} IS NULL OR b.fh_momento >= $P{P_FECHAINICIO})
		AND ($P{P_FECHAFIN} IS NULL OR b.fh_momento <= $P{P_FECHAFIN})
  		AND ($P{P_CD_USUARIO} IS NULL OR b.cd_usuario = $P{P_CD_USUARIO})
  		AND ($P{P_NB_USUARIO} IS NULL OR b.nb_usuario = $P{P_NB_USUARIO})
  		AND ($P{P_NB_PANTA} IS NULL OR b.nb_panta = $P{P_NB_PANTA})
  		AND ($P{P_TP_PANTA} IS NULL OR b.tp_panta = $P{P_TP_PANTA})
  		ORDER BY b.nb_usuario,
   		b.cd_docum,
   		b.fh_momento,
  		b.hr_momento;]]>
	</queryString>
	<field name="tp_panta" class="java.lang.String"/>
	<field name="nb_panta" class="java.lang.String"/>
	<field name="cd_docum" class="java.lang.String"/>
	<field name="nb_usuario" class="java.lang.String"/>
	<field name="fh_momento" class="java.lang.String"/>
	<field name="hr_momento" class="java.lang.String"/>
	<field name="nb_bitac" class="java.lang.String"/>
